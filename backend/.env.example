# Plate Recognizer API (https://platerecognizer.com – ücretsiz 2500/ay)
OCR_API_TOKEN=your_ocr_api_token_here

# Admin API authentication (required for /api/logs, /api/watchlist, /api/images)
ADMIN_API_TOKEN=anpr-dev-admin-token

# SMTP e-posta bildirimleri (VIP / Blacklisted + bariyer acildiginda arac sahibine)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
# SMTP_PASS yerine API token kullaniyorsaniz:
# SMTP_API_TOKEN=your_smtp_provider_token

# Firebase Cloud Messaging HTTP v1 (mobil web push)
FCM_PROJECT_ID=your_firebase_project_id
FCM_SERVICE_ACCOUNT_FILE=/absolute/path/to/firebase-service-account.json

# Optional HTTPS listener (ESP32 secure transport)
TLS_PORT=8443
TLS_CERT_FILE=
TLS_KEY_FILE=
