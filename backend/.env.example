# Plate Recognizer API (https://platerecognizer.com – ücretsiz 2500/ay)
OCR_API_TOKEN=your_ocr_api_token_here

# Admin API authentication (required for /api/logs, /api/watchlist, /api/images)
ADMIN_API_TOKEN=anpr-dev-admin-token

# SMTP e-posta bildirimleri (VIP / Blacklisted tespitinde)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Optional HTTPS listener (ESP32 secure transport)
TLS_PORT=8443
TLS_CERT_FILE=
TLS_KEY_FILE=
